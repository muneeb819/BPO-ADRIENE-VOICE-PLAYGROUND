    {
      "path": "ppt/slides/slide7.xml",
      "blocks": [
        {
          "shape": "Text 2",
          "paragraphs": [
            "MEDICARE BASICS  ·  DETAILED OVERVIEW  ·  2026"
          ]
        },
        {
          "shape": "Text 3",
          "paragraphs": [
            "COVERAGE CHOICES"
          ]
        },
        {
          "shape": "Text 4",
          "paragraphs": [
            "Original Medicare vs. Medicare Advantage (Part C)"
          ]
        },
        {
          "shape": "Text 6",
          "paragraphs": [
            "You choose one path when you first enroll and can switch during certain periods each year."
          ]
        },
        {
          "shape": "Text 9",
          "paragraphs": [
            "Original Medicare"
          ]
        },
        {
          "shape": "Text 10",
          "paragraphs": [
            "Parts Included"
          ]
        },
        {
          "shape": "Text 11",
          "paragraphs": [
            "Part A + Part B (add Part D separately)"
          ]
        },
        {
          "shape": "Text 12",
          "paragraphs": [
            "Provider Choice"
          ]
        },
        {
          "shape": "Text 13",
          "paragraphs": [
            "Any doctor or hospital that accepts Medicare nationwide"
          ]
        },
        {
          "shape": "Text 14",
          "paragraphs": [
            "Referrals"
          ]
        },
        {
          "shape": "Text 15",
          "paragraphs": [
            "Generally not required for specialists"
          ]
        },
        {
          "shape": "Text 16",
          "paragraphs": [
            "Extra Benefits"
          ]
        },
        {
          "shape": "Text 17",
          "paragraphs": [
            "Limited — vision, dental, hearing usually not covered"
          ]
        },
        {
          "shape": "Text 18",
          "paragraphs": [
            "Out-of-Pocket"
          ]
        },
        {
          "shape": "Text 19",
          "paragraphs": [
            "No annual maximum; Medigap can help fill gaps"
          ]
        },
        {
          "shape": "Text 20",
          "paragraphs": [
            "Drug Coverage"
          ]
        },
        {
          "shape": "Text 21",
          "paragraphs": [
            "Optional separate Part D plan"
          ]
        },
        {
          "shape": "Text 24",
          "paragraphs": [
            "Medicare Advantage (Part C)"
          ]
        },
        {
          "shape": "Text 25",
          "paragraphs": [
            "Parts Included"
          ]
        },
        {
          "shape": "Text 26",
          "paragraphs": [
            "Bundled A + B, usually includes Part D"
          ]
        },
        {
          "shape": "Text 27",
          "paragraphs": [
            "Provider Choice"
          ]
        },
        {
          "shape": "Text 28",
          "paragraphs": [
            "Must use plan network (HMO/PPO rules apply)"
          ]
        },
        {
          "shape": "Text 29",
          "paragraphs": [
            "Referrals"
          ]
        },
        {
          "shape": "Text 30",
          "paragraphs": [
            "Often required for specialists (especially HMOs)"
          ]
        },
        {
          "shape": "Text 31",
          "paragraphs": [
            "Extra Benefits"
          ]
        },
        {
          "shape": "Text 32",
          "paragraphs": [
            "Many plans offer dental, vision, hearing, gym, OTC"
          ]
        },
        {
          "shape": "Text 33",
          "paragraphs": [
            "Out-of-Pocket"
          ]
        },
        {
          "shape": "Text 34",
          "paragraphs": [
            "Annual maximum (varies by plan); more predictable costs"
          ]
        },
        {
          "shape": "Text 35",
          "paragraphs": [
            "Drug Coverage"
          ]
        },
        {
          "shape": "Text 36",
          "paragraphs": [
            "Usually included; check formulary carefully"
          ]
        }
      ],
      "tables": [],
