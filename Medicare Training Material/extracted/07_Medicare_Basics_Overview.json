    {
      "path": "ppt/slides/slide6.xml",
      "blocks": [
        {
          "shape": "Text 2",
          "paragraphs": [
            "MEDICARE BASICS  ·  DETAILED OVERVIEW  ·  2026"
          ]
        },
        {
          "shape": "Text 3",
          "paragraphs": [
            "PART B"
          ]
        },
        {
          "shape": "Text 4",
          "paragraphs": [
            "Medical Insurance — What It Covers & Costs (2026)"
          ]
        },
        {
          "shape": "Text 6",
          "paragraphs": [
            "Part B is optional but strongly recommended. Most people pay a monthly premium."
          ]
        },
        {
          "shape": "Text 8",
          "paragraphs": [
            "What Part B Helps Cover"
          ]
        },
        {
          "shape": "Text 9",
          "paragraphs": [
            "•  Services from doctors and other health care providers"
          ]
        },
        {
          "shape": "Text 10",
          "paragraphs": [
            "•  Outpatient hospital care and emergency room visits"
          ]
        },
        {
          "shape": "Text 11",
          "paragraphs": [
            "•  Durable medical equipment (wheelchairs, walkers, oxygen)"
          ]
        },
        {
          "shape": "Text 12",
          "paragraphs": [
            "•  Many preventive services (screenings, vaccines, wellness visits)"
          ]
        },
        {
          "shape": "Text 13",
          "paragraphs": [
            "•  Clinical laboratory tests and diagnostic imaging"
          ]
        },
        {
          "shape": "Text 14",
          "paragraphs": [
            "•  Mental health services (outpatient)"
          ]
        },
        {
          "shape": "Text 15",
          "paragraphs": [
            "•  Ambulance services and some home health care"
          ]
        },
        {
          "shape": "Text 16",
          "paragraphs": [
            "•  Limited prescription drugs administered by a provider"
          ]
        },
        {
          "shape": "Text 18",
          "paragraphs": [
            "2026 Part B Costs"
          ]
        },
        {
          "shape": "Text 19",
          "paragraphs": [
            "Standard Monthly Premium"
          ]
        },
        {
          "shape": "Text 20",
          "paragraphs": [
            "$202.90"
          ]
        },
        {
          "shape": "Text 21",
          "paragraphs": [
            "(Higher for higher incomes — IRMAA applies)"
          ]
        },
        {
          "shape": "Text 22",
          "paragraphs": [
            "Annual Deductible"
          ]
        },
        {
          "shape": "Text 23",
          "paragraphs": [
            "$283"
          ]
        },
        {
          "shape": "Text 24",
          "paragraphs": [
            "Coinsurance"
          ]
        },
        {
          "shape": "Text 25",
          "paragraphs": [
            "Usually 20% of Medicare-approved amount after deductible"
          ]
        },
        {
          "shape": "Text 26",
          "paragraphs": [
            "No annual out-of-pocket maximum under Original Medicare"
          ]
        }
      ],
