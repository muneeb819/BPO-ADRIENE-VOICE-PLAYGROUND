        {
          "shape": "Text 2",
          "paragraphs": [
            "MEDICARE BASICS  ·  DETAILED OVERVIEW  ·  2026"
          ]
        },
        {
          "shape": "Text 3",
          "paragraphs": [
            "INTRODUCTION"
          ]
        },
        {
          "shape": "Text 4",
          "paragraphs": [
            "What is Medicare?"
          ]
        },
        {
          "shape": "Text 6",
          "paragraphs": [
            "Federal health insurance established in 1965 under Title XVIII of the Social Security Act."
          ]
        },
        {
          "shape": "Text 9",
          "paragraphs": [
            "65+"
          ]
        },
        {
          "shape": "Text 10",
          "paragraphs": [
            "Who It Serves"
          ]
        },
        {
          "shape": "Text 11",
          "paragraphs": [
            "People age 65 and older",
            "Certain younger people with",
            "disabilities",
            "People with End-Stage Renal",
            "Disease (ESRD) or ALS"
          ]
        },
        {
          "shape": "Text 14",
          "paragraphs": [
            "A–D"
          ]
        },
        {
          "shape": "Text 15",
          "paragraphs": [
            "How It Works"
          ]
        },
        {
          "shape": "Text 16",
          "paragraphs": [
            "Covers hospital care,",
            "doctor visits, preventive",
            "services, and prescription",
            "drugs through four parts"
          ]
        },
        {
          "shape": "Text 19",
          "paragraphs": [
            "CMS"
          ]
        },
        {
          "shape": "Text 20",
          "paragraphs": [
            "Administration"
          ]
        },
        {
          "shape": "Text 21",
          "paragraphs": [
            "Run by the Centers for",
            "Medicare & Medicaid",
            "Services (CMS)",
            "Funded by taxes, premiums",
            "and federal budget"
          ]
        },
        {
          "shape": "Text 24",
          "paragraphs": [
            "70M"
          ]
        },
        {
          "shape": "Text 25",
          "paragraphs": [
            "Scale"
          ]
        },
        {
          "shape": "Text 26",
          "paragraphs": [
            "Serves more than 70 million",
            "Americans (2026)",
            "Nearly all people 65+",
            "have coverage"
          ]
        }
      ],
      "tables": [],
      "notes": "2",
      "imageAssetsInDeck": 0,
      "number": 2
    },
    {
      "path": "ppt/slides/slide3.xml",
      "blocks": [
        {
          "shape": "Text 2",
          "paragraphs": [
            "MEDICARE BASICS  ·  DETAILED OVERVIEW  ·  2026"
          ]
        },
        {
          "shape": "Text 3",
          "paragraphs": [
            "ELIGIBILITY"
          ]
        },
        {
          "shape": "Text 4",
          "paragraphs": [
            "Who Qualifies for Medicare?"
          ]
        },
        {
          "shape": "Text 6",
          "paragraphs": [
            "You must generally be a U.S. citizen or lawful permanent resident who has lived in the U.S. for at least 5 years."
          ]
        },
        {
          "shape": "Text 8",
          "paragraphs": [
            "Primary Pathways"
          ]
        },
        {
          "shape": "Text 9",
          "paragraphs": [
            "01"
          ]
        },
        {
          "shape": "Text 10",
          "paragraphs": [
            "Age 65 or Older"
          ]
        },
        {
          "shape": "Text 11",
          "paragraphs": [
            "Most common path. Automatic enrollment if already receiving Social Security benefits."
          ]
        },
        {
          "shape": "Text 12",
          "paragraphs": [
            "02"
          ]
        },
        {
          "shape": "Text 13",
          "paragraphs": [
            "Disability"
          ]
        },
        {
          "shape": "Text 14",
          "paragraphs": [
            "Under 65 and entitled to Social Security disability benefits for 24 months (waiting period may be waived)."
          ]
        },
        {
          "shape": "Text 15",
          "paragraphs": [
            "03"
          ]
        },
        {
          "shape": "Text 16",
          "paragraphs": [
            "ESRD"
          ]
        },
        {
          "shape": "Text 17",
          "paragraphs": [
            "Any age with permanent kidney failure requiring dialysis or a kidney transplant."
          ]
        },
        {
          "shape": "Text 18",
          "paragraphs": [
            "04"
          ]
        },
        {
          "shape": "Text 19",
          "paragraphs": [
            "ALS (Lou Gehrig's)"
          ]
        },
        {
          "shape": "Text 20",
          "paragraphs": [
            "Any age diagnosed with amyotrophic lateral sclerosis — no waiting period."
          ]
        },
        {
          "shape": "Text 22",
          "paragraphs": [
            "Premium-Free Part A"
          ]
        },
        {
          "shape": "Text 23",
          "paragraphs": [
            "Most people get Part A at no monthly cost if they (or a spouse) paid Medicare taxes for at least 10 years (40 quarters) while working."
          ]
        },
        {
          "shape": "Text 25",
          "paragraphs": [
            "Key Notes"
          ]
        },
        {
          "shape": "Text 26",
          "paragraphs": [
            "• Part B is optional but most people enroll",
            "• You can buy Part A if you do not qualify for free coverage",
            "• Enrollment is not always automatic — check your situation",
            "• Spousal work history can help you qualify"
          ]
        }
      ],
      "tables": [],
      "notes": "3",
      "imageAssetsInDeck": 0,
      "number": 3
    },
    {
      "path": "ppt/slides/slide4.xml",
      "blocks": [
        {
          "shape": "Text 2",
          "paragraphs": [
            "MEDICARE BASICS  ·  DETAILED OVERVIEW  ·  2026"
          ]
        },
        {
          "shape": "Text 3",
          "paragraphs": [
            "STRUCTURE"
          ]
        },
        {
          "shape": "Text 4",
          "paragraphs": [
            "The Four Parts of Medicare"
          ]
        },
        {
          "shape": "Text 6",
          "paragraphs": [
            "Medicare is organized into four distinct parts that cover different types of services."
          ]
        },
        {
          "shape": "Text 9",
          "paragraphs": [
            "A"
          ]
        },
        {
          "shape": "Text 10",
          "paragraphs": [
            "Hospital Insurance"
          ]
        },
        {
          "shape": "Text 11",
          "paragraphs": [
            "•  Inpatient hospital stays"
          ]
        },
        {
          "shape": "Text 12",
          "paragraphs": [
            "•  Skilled nursing facility care"
          ]
        },
        {
          "shape": "Text 13",
          "paragraphs": [
            "•  Hospice care"
          ]
        },
        {
          "shape": "Text 14",
          "paragraphs": [
            "•  Some home health care"
          ]
        },
        {
          "shape": "Text 17",
          "paragraphs": [
            "B"
          ]
        },
        {
          "shape": "Text 18",
          "paragraphs": [
            "Medical Insurance"
          ]
        },
        {
          "shape": "Text 19",
          "paragraphs": [
            "•  Doctor & provider services"
          ]
        },
        {
          "shape": "Text 20",
          "paragraphs": [
            "•  Outpatient care"
          ]
        },
        {
          "shape": "Text 21",
          "paragraphs": [
            "•  Durable medical equipment"
          ]
        },
        {
          "shape": "Text 22",
          "paragraphs": [
            "•  Preventive services & screenings"
          ]
        },
        {
          "shape": "Text 25",
          "paragraphs": [
            "C"
          ]
        },
        {
          "shape": "Text 26",
          "paragraphs": [
            "Medicare Advantage"
          ]
        },
        {
          "shape": "Text 27",
          "paragraphs": [
            "•  Private plan alternative"
          ]
        },
        {
          "shape": "Text 28",
          "paragraphs": [
            "•  Bundles A + B (often D)"
          ]
        },
        {
          "shape": "Text 29",
          "paragraphs": [
            "•  May include extra benefits"
          ]
        },
        {
          "shape": "Text 30",
          "paragraphs": [
            "•  Network-based coverage"
          ]
        },
        {
          "shape": "Text 33",
          "paragraphs": [
            "D"
          ]
        },
        {
          "shape": "Text 34",
          "paragraphs": [
            "Prescription Drugs"
          ]
        },
        {
          "shape": "Text 35",
          "paragraphs": [
            "•  Outpatient prescription drugs"
          ]
        },
        {
          "shape": "Text 36",
          "paragraphs": [
            "•  Many recommended vaccines"
          ]
        },
        {
          "shape": "Text 37",
          "paragraphs": [
            "•  Run by private plans"
          ]
        },
        {
          "shape": "Text 38",
          "paragraphs": [
            "•  Available with Original or MA"
          ]
        }
      ],
      "tables": [],
      "notes": "4",
      "imageAssetsInDeck": 0,
      "number": 4
    },
    {
      "path": "ppt/slides/slide5.xml",
      "blocks": [
        {
          "shape": "Text 2",
          "paragraphs": [
            "MEDICARE BASICS  ·  DETAILED OVERVIEW  ·  2026"
          ]
        },
        {
          "shape": "Text 3",
          "paragraphs": [
            "PART A"
          ]
        },
        {
          "shape": "Text 4",
          "paragraphs": [
            "Hospital Insurance — What It Covers & Costs (2026)"
          ]
        },
        {
          "shape": "Text 6",
          "paragraphs": [
            "Most people receive premium-free Part A after paying Medicare taxes for at least 10 years."
          ]
        },
        {
          "shape": "Text 8",
          "paragraphs": [
            "What Part A Helps Cover"
          ]
        },
        {
          "shape": "Text 9",
          "paragraphs": [
            "Inpatient Hospital Care"
          ]
        },
        {
          "shape": "Text 10",
          "paragraphs": [
            "Semi-private room, meals, general nursing, drugs as part of inpatient treatment, and other hospital services."
          ]
        },
        {
          "shape": "Text 11",
          "paragraphs": [
            "Skilled Nursing Facility (SNF)"
          ]
        },
        {
          "shape": "Text 12",
          "paragraphs": [
            "Care after a qualifying 3-day hospital stay. Days 1–20 fully covered after deductible; coinsurance applies days 21–100."
          ]
        },
        {
          "shape": "Text 13",
          "paragraphs": [
            "Hospice Care"
          ]
        },
        {
          "shape": "Text 14",
          "paragraphs": [
            "For terminally ill patients. Includes pain relief, support services, and counseling. Minimal cost sharing."
          ]
        },
        {
          "shape": "Text 15",
          "paragraphs": [
            "Home Health Care"
          ]
        },
        {
          "shape": "Text 16",
          "paragraphs": [
            "Part-time skilled nursing, physical/occupational therapy, and home health aide services when medically necessary."
          ]
        },
        {
          "shape": "Text 18",
          "paragraphs": [
            "2026 Part A Costs"
          ]
        },
        {
          "shape": "Text 19",
          "paragraphs": [
            "Premium (most people)"
          ]
        },
        {
          "shape": "Text 20",
          "paragraphs": [
            "$0"
          ]
        },
        {
          "shape": "Text 21",
          "paragraphs": [
            "Premium (30–39 quarters)"
          ]
        },
        {
          "shape": "Text 22",
          "paragraphs": [
            "$311/mo"
          ]
        },
        {
          "shape": "Text 23",
          "paragraphs": [
            "Premium (<30 quarters)"
          ]
        },
        {
          "shape": "Text 24",
          "paragraphs": [
            "$565/mo"
          ]
        },
        {
          "shape": "Text 25",
          "paragraphs": [
            "Hospital deductible (per benefit period)"
          ]
        },
        {
          "shape": "Text 26",
          "paragraphs": [
            "$1,736"
          ]
        },
        {
          "shape": "Text 27",
          "paragraphs": [
            "Days 61–90 coinsurance"
          ]
        },
        {
          "shape": "Text 28",
          "paragraphs": [
            "$434/day"
          ]
        },
        {
          "shape": "Text 29",
          "paragraphs": [
            "Lifetime reserve days"
          ]
        },
        {
          "shape": "Text 30",
          "paragraphs": [
            "$868/day"
          ]
        },
        {
          "shape": "Text 31",
          "paragraphs": [
            "SNF days 21–100 coinsurance"
          ]
        },
        {
          "shape": "Text 32",
          "paragraphs": [
            "$217/day"
          ]
        }
      ],
