        {
          "shape": "Text 0",
          "paragraphs": [
            "Step 4 — Needs Discovery"
          ]
        },
        {
          "shape": "Text 1",
          "paragraphs": [
            "Listen more than you talk. These questions uncover what truly matters."
          ]
        },
        {
          "shape": "Text 4",
          "paragraphs": [
            "1"
          ]
        },
        {
          "shape": "Text 5",
          "paragraphs": [
            "Current Coverage"
          ]
        },
        {
          "shape": "Text 6",
          "paragraphs": [
            "What type of coverage do you have now? (Original + Supplement, MA, Part D, etc.)"
          ]
        },
        {
          "shape": "Text 9",
          "paragraphs": [
            "2"
          ]
        },
        {
          "shape": "Text 10",
          "paragraphs": [
            "Satisfaction"
          ]
        },
        {
          "shape": "Text 11",
          "paragraphs": [
            "How happy are you with your current plan? Any costs, coverage gaps, or access issues?"
          ]
        },
        {
          "shape": "Text 14",
          "paragraphs": [
            "3"
          ]
        },
        {
          "shape": "Text 15",
          "paragraphs": [
            "Providers"
          ]
        },
        {
          "shape": "Text 16",
          "paragraphs": [
            "Which doctors, specialists, or hospitals are most important for you to keep?"
          ]
        },
        {
          "shape": "Text 19",
          "paragraphs": [
            "4"
          ]
        },
        {
          "shape": "Text 20",
          "paragraphs": [
            "Medications"
          ]
        },
        {
          "shape": "Text 21",
          "paragraphs": [
            "What prescription medications do you take regularly?"
          ]
        },
        {
          "shape": "Text 24",
          "paragraphs": [
            "5"
          ]
        },
        {
          "shape": "Text 25",
          "paragraphs": [
            "Priorities"
          ]
        },
        {
          "shape": "Text 26",
          "paragraphs": [
            "What matters most — lower premiums, predictable costs, dental/vision, broader network?"
          ]
        },
        {
          "shape": "Text 29",
          "paragraphs": [
            "6"
          ]
        },
        {
          "shape": "Text 30",
          "paragraphs": [
            "Upcoming Needs"
          ]
        },
        {
          "shape": "Text 31",
          "paragraphs": [
