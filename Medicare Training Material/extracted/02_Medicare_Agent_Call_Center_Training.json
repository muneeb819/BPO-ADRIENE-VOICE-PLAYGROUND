          "paragraphs": [
            "Key Knowledge Agents Must Master"
          ]
        },
        {
          "shape": "Text 2",
          "paragraphs": [
            "Parts of Medicare"
          ]
        },
        {
          "shape": "Text 3",
          "paragraphs": [
            "•  A – Hospital Insurance"
          ]
        },
        {
          "shape": "Text 4",
          "paragraphs": [
            "•  B – Medical Insurance"
          ]
        },
        {
          "shape": "Text 5",
          "paragraphs": [
            "•  C – Medicare Advantage"
          ]
        },
        {
          "shape": "Text 6",
          "paragraphs": [
            "•  D – Prescription Drugs"
          ]
        },
        {
          "shape": "Text 7",
          "paragraphs": [
            "•  Medigap – Supplements Original"
          ]
        },
        {
          "shape": "Text 9",
          "paragraphs": [
            "Main Enrollment Periods"
          ]
        },
        {
          "shape": "Text 10",
          "paragraphs": [
            "•  IEP – around 65th birthday"
          ]
        },
        {
          "shape": "Text 11",
          "paragraphs": [
            "•  AEP – Oct 15 to Dec 7"
          ]
        },
        {
          "shape": "Text 12",
          "paragraphs": [
            "•  MA OEP – Jan 1 to Mar 31"
          ]
        },
        {
          "shape": "Text 13",
          "paragraphs": [
            "•  SEPs – qualifying life events"
          ]
        },
        {
          "shape": "Text 15",
          "paragraphs": [
            "Original vs Advantage"
          ]
        },
        {
          "shape": "Text 16",
          "paragraphs": [
            "•  Original: any provider accepting Medicare"
          ]
        },
        {
          "shape": "Text 17",
          "paragraphs": [
            "•  Advantage: network, often extra benefits"
          ]
        },
        {
          "shape": "Text 18",
          "paragraphs": [
            "•  Advantage has annual OOP max"
          ]
        },
        {
          "shape": "Text 19",
          "paragraphs": [
            "•  Trade-offs must be stated clearly"
          ]
        },
        {
          "shape": "Text 21",
          "paragraphs": [
            "Always Offer Alternatives"
          ]
        },
        {
          "shape": "Text 22",
          "paragraphs": [
            "•  Medicare.gov"
          ]
        },
        {
          "shape": "Text 23",
          "paragraphs": [
            "•  1-800-MEDICARE"
          ]
        },
        {
          "shape": "Text 24",
          "paragraphs": [
            "•  Local SHIP counselor"
          ]
        },
        {
          "shape": "Text 25",
          "paragraphs": [
            "•  Independent comparison tools"
          ]
        },
        {
          "shape": "Text 26",
