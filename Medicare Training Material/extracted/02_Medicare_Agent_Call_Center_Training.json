    {
      "path": "ppt/slides/slide10.xml",
      "blocks": [
        {
          "shape": "Text 0",
          "paragraphs": [
            "Steps 5–7 — Recap, Present, Close"
          ]
        },
        {
          "shape": "Text 3",
          "paragraphs": [
            "5. Recap"
          ]
        },
        {
          "shape": "Text 4",
          "paragraphs": [
            "•  Summarize doctors, meds, priorities, and budget concerns"
          ]
        },
        {
          "shape": "Text 5",
          "paragraphs": [
            "•  Ask: “Did I get that right? Anything missing?”"
          ]
        },
        {
          "shape": "Text 6",
          "paragraphs": [
            "•  Builds trust and prevents mis-matches"
          ]
        },
        {
          "shape": "Text 9",
          "paragraphs": [
            "6. Present Options"
          ]
        },
        {
          "shape": "Text 10",
          "paragraphs": [
            "•  Stay within the SOA products only"
          ]
        },
        {
          "shape": "Text 11",
          "paragraphs": [
            "•  Present 1–3 relevant options factually"
          ]
        },
        {
          "shape": "Text 12",
          "paragraphs": [
            "•  State trade-offs clearly (network, prior auth, costs)"
          ]
        },
        {
          "shape": "Text 13",
          "paragraphs": [
            "•  Remind: “I do not offer every plan in your area”"
          ]
        },
        {
          "shape": "Text 16",
          "paragraphs": [
            "7. Close / Next Steps"
          ]
        },
        {
          "shape": "Text 17",
          "paragraphs": [
            "•  If ready: confirm understanding, complete enrollment"
          ]
        },
        {
          "shape": "Text 18",
          "paragraphs": [
            "•  If not: offer summary + schedule follow-up"
          ]
        },
        {
          "shape": "Text 19",
          "paragraphs": [
            "•  Never pressure same-call enrollment"
          ]
        },
        {
          "shape": "Text 20",
          "paragraphs": [
            "•  End with contact info + Medicare.gov / 1-800-MEDICARE"
          ]
        },
        {
          "shape": "Text 21",
          "paragraphs": [
            "Medicare Agent Training  |  Compliant Call Scripts"
          ]
        },
        {
          "shape": "Text 22",
          "paragraphs": [
            "10"
          ]
