# ---------------------------------------------------------------------------
# BPO Adriene Playground - backend-only environment
# Copy this file to `.env` and fill in only the providers you want to use.
# Never put these values in assets/js/*.js or any HTML file.
# ---------------------------------------------------------------------------

# Enables Deepgram Aura TTS (/api/tts) and Nova-2 STT (/api/stt).
# When present, the seeded Adriene persona uses aura-asteria-en + Nova-2
# and Deepgram becomes the default STT/TTS provider. Keys stay server-side.
DEEPGRAM_API_KEY=

# Used only by the Voice Lab "Test" button (no audio is sent by this build)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Optional bearer-token gate for /api/*. Leave disabled for localhost use.
AUTH_ENABLED=false
AUTH_SECRET=

# Live SIP/PSTN remains blocked in this build. Mock telephony works either way.
TELEPHONY_ENABLED=false

# Optional HTTP port (default 8000; the launcher falls back to the next free port)
PORT=8000
